{
  "title": "DriftWatch — agent-decisions",
  "uid": "driftwatch-agent-decisions",
  "schemaVersion": 39,
  "tags": ["driftwatch", "gen_ai.agent"],
  "panels": [
    {
      "type": "stat",
      "title": "Drift decisions by gate.action",
      "description": "Counts of gen_ai.agent.gate.action = log/drop/block",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "targets": [{"expr": "sum by (gate_action) (driftwatch_decisions_total)"}]
    },
    {
      "type": "timeseries",
      "title": "Drift score (gen_ai.evaluation.score.value)",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, driftwatch_score_value_bucket)"}]
    },
    {
      "type": "piechart",
      "title": "Anomaly kinds",
      "description": "gen_ai.agent.computed.anomaly.kind distribution",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 6},
      "targets": [{"expr": "sum by (anomaly_kind) (driftwatch_anomaly_total)"}]
    },
    {
      "type": "stat",
      "title": "False-positive rate (tuning signal, NFR-3)",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 8},
      "targets": [{"expr": "driftwatch_false_positive_rate"}]
    }
  ]
}
